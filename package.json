{
    "name": "obsidian-ballistics-plugin",
    "version": "0.2.2",
    "description": "Embed ballistics data in Obsidian notes.",
    "author": "Jason Heddings",
    "license": "MIT",
    "main": "main.js",
    "scripts": {
        "prepare": "husky",
        "dev": "node esbuild.config.mjs",
        "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
        "test": "vitest run"
    },
    "keywords": [
        "obsidian",
        "plugin",
        "ballistics",
        "shooting"
    ],
    "devDependencies": {
        "@types/node": "^26.6.11",
        "@typescript-eslint/eslint-plugin": "8.73.0",
        "@typescript-eslint/parser": "8.73.0",
        "esbuild": "0.28.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.9",
        "eslint-plugin-obsidianmd": "^0.6.0",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.14.0",
        "happy-dom": "^21.0.4",
        "husky": "^9.1.7",
        "nano-staged": "^1.0.2",
        "obsidian": "latest",
        "prettier": "^3.10.1",
        "tslib": "2.9.1",
        "typescript": "6.0.3",
        "vitest": "^5.1.2"
    },
    "nano-staged": {
        "*.{js,jsx,ts,tsx,json,css,scss,md}": [
            "prettier --check",
            "eslint"
        ]
    },
    "dependencies": {
        "js-ballistics": "^3.2.1",
        "obskit": "^2.0.0"
    }
}
